{
  "name": "dsh-zotero-sync",
  "version": "1.3.1",
  "description": "把对话中产出的 Markdown/PDF/Office 文档同步进本机 Zotero 文库，并可只读检索文库、提取 PDF 全文 / Sync documents produced in DeepSeek Harness chats into a local Zotero library, and read the library back (search, metadata, PDF full text, BibTeX)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "zotero",
    "zotero-api",
    "literature",
    "literature-review",
    "reference-manager",
    "markdown",
    "notes",
    "notes-sync",
    "pdf",
    "bibtex"
  ],
  "license": "MIT",
  "author": "Ycx66",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/520limited/dsh-zotero-sync.git"
  },
  "bugs": {
    "url": "https://github.com/520limited/dsh-zotero-sync/issues"
  },
  "homepage": "https://github.com/520limited/dsh-zotero-sync#readme",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./zotero.mjs": "./zotero.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "zotero.mjs",
    "library.mjs",
    "settings.mjs",
    "operations.mjs",
    "history.mjs",
    "title.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/protocol.test.mjs && node test/behaviour.test.mjs && node test/group.test.mjs && node test/title.test.mjs && node test/package.test.mjs && node test/deliverables.test.mjs && node test/library.test.mjs",
    "test:live": "node test/live-sync.test.mjs && node test/live-group.test.mjs",
    "market": "node market/make-index.mjs"
  },
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
