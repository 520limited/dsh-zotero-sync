{
  "name": "dsh-zotero-sync",
  "version": "1.1.0",
  "description": "把对话中产出的 Markdown/文档一键同步到本机 Zotero 文库 / Sync conversation documents into your local Zotero library",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "zotero",
    "literature",
    "markdown",
    "notes"
  ],
  "license": "MIT",
  "author": "Ycx66",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/520limited/dsh-zotero-sync.git"
  },
  "bugs": {
    "url": "https://github.com/520limited/dsh-zotero-sync/issues"
  },
  "homepage": "https://github.com/520limited/dsh-zotero-sync#readme",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./zotero.mjs": "./zotero.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "zotero.mjs",
    "library.mjs",
    "settings.mjs",
    "operations.mjs",
    "history.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
